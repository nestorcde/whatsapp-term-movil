# Configuración del servidor
PORT=3000

# Nivel de log (ERROR, WARN, INFO, DEBUG)
# ERROR: Solo errores críticos (producción)
# WARN: Errores y advertencias
# INFO: Información general + errores + advertencias (predeterminado, recomendado)
# DEBUG: Todos los logs incluyendo depuración detallada de WPPConnect (desarrollo)
#
# NOTA: Con INFO o menos, los logs internos de WPPConnect están silenciados
#       Con DEBUG, se mostrarán todos los logs de WPPConnect para depuración
LOG_LEVEL=INFO

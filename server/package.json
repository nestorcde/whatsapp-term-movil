{
  "name": "whatsapp-termux",
  "version": "1.0.0",
  "description": "Cliente de WhatsApp Web para Termux usando WPPConnect con API REST",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "bot": "ts-node src/index.ts",
    "clean": "rimraf dist session tokens",
    "setup:termux": "bash setup-termux.sh",
    "install:termux": "npm run setup:termux && npm start"
  },
  "keywords": [
    "whatsapp",
    "termux",
    "wppconnect",
    "bot",
    "api",
    "rest"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@wppconnect-team/wppconnect": "1.37.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
